# Получить токен у @BotFather. Не отправляйте токен в переписку.
BOT_TOKEN=PUT_BOTFATHER_TOKEN_HERE
# Числовые ID указывать не нужно. Остальные настройки можно оставить по умолчанию.
BOT_NAME=Gift Offer
DEFAULT_LANGUAGE=ru
OFFER_TTL_SECONDS=21600
CREATE_COOLDOWN_SECONDS=3
DB_PATH=data/offers.sqlite3
# 0 отключает HTTP. На хостинге используйте выданный PORT (обычно 3000).
PORT=3000
